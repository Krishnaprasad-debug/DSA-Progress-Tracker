# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and Cookie transport)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas in staging/production, memory server in tests)
MONGODB_URI=mongodb://localhost:27017/dsa-progress-tracker

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signature_secret
